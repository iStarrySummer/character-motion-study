{
  "study_name": "FAVE Section 5.3 Human Evaluation (3-Form Stratified IBD)",
  "version": "v19",
  "video_rules": {
    "mute_all_videos": true,
    "require_uniform_resolution": "320p",
    "part_a_watch_completion_required_pct": 100
  },
  "SETTING_DIR": {
    "setting_01": "setting_01__original_audio__lora_off__noprompt",
    "setting_03": "setting_03__tts_original_guided__lora_off__noprompt",
    "setting_04": "setting_04__tts_original_guided__lora_off__prompt",
    "setting_05": "setting_05__tts_neutral_reference__lora_off__noprompt",
    "setting_07": "setting_07__tts_original_guided__lora_on__noprompt"
  },
  "PATH_TEMPLATE": "videos_320p_muted/{SETTING_DIR}/{character}/{scene_id}.mp4",
  "randomization_rules": {
    "form_assignment": "Round-robin or random balanced across Form1, Form2, Form3 (target 12-13 participants per form -> >=10 valid after QC).",
    "part_a_ab_swap": "At participant session start, assign base/test to Left(A)/Right(B) with exact 50/50 balance within each task (audio, prompt, lora). Never show setting names in UI."
  },
  "questions": {
    "PartA_Pairwise": {
      "q1_diff": {
        "field": "diff_score",
        "required": true,
        "label_zh": "A 和 B 的头部运动和面部表情像不像？",
        "label_en": "How similar are A and B in their head movements and facial expressions?",
        "options": [
          {
            "value": 0,
            "label_zh": "基本一致",
            "label_en": "Nearly identical"
          },
          {
            "value": 1,
            "label_zh": "有肉眼可见的差别",
            "label_en": "Visibly different"
          }
        ]
      },
      "q2_choice": {
        "field": "choice_raw",
        "required": true,
        "label_zh": "哪一个候选视频的头部运动和面部表情更像参考视频？",
        "label_en": "Which candidate more closely matches the head movements and facial expressions in the reference video?",
        "options": [
          {
            "value": "A",
            "label_zh": "选择 A",
            "label_en": "Choose A"
          },
          {
            "value": "B",
            "label_zh": "选择 B",
            "label_en": "Choose B"
          }
        ],
        "show_when": "diff_score == 1"
      },
      "q3_reasons_optional": {
        "field": "reason_tags",
        "required": false,
        "show_when": "choice_raw in ['A', 'B']",
        "multi_select": true,
        "label_zh": "你为什么选择这位候选人？",
        "label_en": "Why did you choose this candidate?",
        "options": [
          {
            "value": "head_motion",
            "label_zh": "头部运动更相似",
            "label_en": "More similar head movements"
          },
          {
            "value": "brow_motion",
            "label_zh": "眉毛动作（包括皱眉时的纹路）更相似",
            "label_en": "More similar brow movements and creases"
          },
          {
            "value": "eye_motion",
            "label_zh": "眼部动作更相似",
            "label_en": "More similar eye movements"
          },
          {
            "value": "mouth_motion",
            "label_zh": "嘴部运动更相似",
            "label_en": "More similar mouth movements"
          }
        ]
      },
      "q2_reference": {
        "field": "both_resemble_reference",
        "required": true,
        "show_when": "diff_score == 0",
        "label_en": "Do both candidates resemble the reference in their head movements and facial expressions?",
        "label_zh": "两个候选视频的头部运动和面部表情都像中间的参考视频吗？",
        "options": [
          {
            "value": "yes",
            "label_en": "Yes",
            "label_zh": "是"
          },
          {
            "value": "no",
            "label_en": "No",
            "label_zh": "否"
          }
        ]
      }
    }
  },
  "qc_rules": {
    "qc_pair_pass": "diff_score == 0",
    "min_total_duration_sec": 360,
    "participant_valid_rule": "Pass the identical-pair check and total_duration_sec >= 360"
  },
  "forms_summary": {
    "Form1": {
      "total_trials": 26,
      "part_a_count": 26,
      "character_block_order": [
        "Penny",
        "Sheldon",
        "Leonard"
      ]
    },
    "Form2": {
      "total_trials": 26,
      "part_a_count": 26,
      "character_block_order": [
        "Sheldon",
        "Leonard",
        "Penny"
      ]
    },
    "Form3": {
      "total_trials": 27,
      "part_a_count": 27,
      "character_block_order": [
        "Leonard",
        "Penny",
        "Sheldon"
      ]
    }
  }
}
